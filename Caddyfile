# Caddy configuration for automatic Let's Encrypt SSL
# If DOMAIN is not set in .env.local, it falls back to localhost or public IP
{$DOMAIN:localhost} {
    # Reverse proxy all web traffic to the Bagstack Next.js container
    reverse_proxy bagstack:3000

    # Modern compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
