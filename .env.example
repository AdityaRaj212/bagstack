# Bagstack Environment Configuration

# Server Port (optional, defaults to 3000)
PORT=3000

# Nodemailer / SMTP Configuration for Passwordless Email OTP
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: Turso Cloud SQLite Configuration (For zero-cost cloud persistence)
# Create a free database at: https://turso.tech
TURSO_DATABASE_URL=libsql://bagstack-[your-name].turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: AI assistant (statement/receipt import + natural-language queries)
# Without a key the app uses a deterministic offline rules engine (text/CSV only).
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic            # anthropic | offline (default: anthropic when a key is set)
# AI_MODEL=claude-opus-5-5
# AI_TIMEOUT_MS=60000              # per attempt
# AI_MAX_RETRIES=2                 # retries on 429/5xx/timeouts
# AI_DAILY_USER_BUDGET_MICRO_USD=500000     # $0.50 per profile per 24h
# AI_DAILY_GLOBAL_BUDGET_MICRO_USD=10000000 # $10 across all users per 24h
